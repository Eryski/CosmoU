{
 "name": "cosmou",
 "productName": "CosmoU",
 "version": "0.9.0",
 "description": "CosmoU – a Wii U style launcher for Cemu",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win --publish never",
  "preview": "node scripts/build-preview.js"
 },
 "devDependencies": {
  "electron": "^33.0.0",
  "electron-builder": "^25.1.8"
 },
 "dependencies": {
  "adm-zip": "^0.5.16"
 },
 "build": {
  "appId": "com.cosmou.app",
  "productName": "CosmoU",
  "directories": {
   "output": "dist"
  },
  "files": [
   "main.js",
   "preload.js",
   "index.html",
   "css/**",
   "js/**",
   "package.json",
   "build/icon.png"
  ],
  "extraResources": [
   {
    "from": "assets/music",
    "to": "music",
    "filter": [
     "*.wav",
     "*.mp3",
     "*.ogg",
     "*.m4a",
     "*.flac"
    ]
   }
  ],
  "win": {
   "icon": "build/icon.ico",
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    },
    {
     "target": "portable",
     "arch": [
      "x64"
     ]
    }
   ]
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "artifactName": "CosmoU-Setup-${version}.exe"
  },
  "portable": {
   "artifactName": "CosmoU-Portable-${version}.exe"
  }
 }
}
