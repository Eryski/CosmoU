{
 "name": "cosmou",
 "productName": "CosmoU",
 "version": "0.11.2",
 "description": "CosmoU – a Wii U style launcher for Cemu",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win --publish never",
  "preview": "node scripts/build-preview.js",
  "dist:linux": "electron-builder --linux --publish never"
 },
 "devDependencies": {
  "electron": "^33.0.0",
  "electron-builder": "^25.1.8"
 },
 "dependencies": {
  "adm-zip": "^0.5.16"
 },
 "build": {
  "appId": "com.cosmou.app",
  "productName": "CosmoU",
  "directories": {
   "output": "dist"
  },
  "files": [
   "main.js",
   "platform.js",
   "preload.js",
   "index.html",
   "css/**",
   "js/**",
   "package.json",
   "build/icon.png"
  ],
  "extraResources": [
   {
    "from": "assets/music/themes",
    "to": "music/themes",
    "filter": [
     "*.ogg"
    ]
   },
   {
    "from": "assets/music",
    "to": "music",
    "filter": [
     "*.wav",
     "*.mp3",
     "*.ogg",
     "*.m4a",
     "*.flac"
    ]
   }
  ],
  "win": {
   "icon": "build/icon.ico",
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    },
    {
     "target": "portable",
     "arch": [
      "x64"
     ]
    }
   ]
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "artifactName": "CosmoU-Setup-${version}.exe"
  },
  "portable": {
   "artifactName": "CosmoU-Portable-${version}.exe"
  },
  "afterPack": "scripts/linux-after-pack.js",
  "linux": {
   "icon": "build/icon.png",
   "executableName": "cosmou",
   "category": "Game",
   "synopsis": "A Wii U style launcher for Cemu",
   "description": "CosmoU is a Wii U style launcher for the Cemu emulator: your games as covers, a grid or the Wii U Home Menu, with graphic packs, save backups, controller support and themes.",
   "maintainer": "ErykBS <https://github.com/Eryski/CosmoU>",
   "vendor": "ErykBS",
   "desktop": {
    "Name": "CosmoU",
    "Comment": "Wii U style launcher for Cemu",
    "Keywords": "wiiu;cemu;emulator;launcher;games;"
   },
   "target": [
    {
     "target": "AppImage",
     "arch": [
      "x64"
     ]
    },
    {
     "target": "deb",
     "arch": [
      "x64"
     ]
    },
    {
     "target": "tar.gz",
     "arch": [
      "x64"
     ]
    }
   ]
  },
  "appImage": {
   "artifactName": "CosmoU-${version}-x86_64.${ext}"
  },
  "deb": {
   "artifactName": "CosmoU-${version}-amd64.${ext}",
   "depends": [
    "libgtk-3-0 | libgtk-3-0t64",
    "libnotify4",
    "libnss3",
    "libxss1",
    "libxtst6",
    "xdg-utils",
    "libatspi2.0-0 | libatspi2.0-0t64",
    "libuuid1",
    "libsecret-1-0"
   ]
  }
 },
 "homepage": "https://github.com/Eryski/CosmoU",
 "author": {
  "name": "ErykBS",
  "url": "https://github.com/Eryski"
 }
}
